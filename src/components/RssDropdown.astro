---
import { Icon } from 'astro-icon/components'

interface Props {
  class?: string
  placement?: 'bottom' | 'top'
  align?: 'start' | 'end'
}

const { class: className, placement = 'bottom', align = 'start' } = Astro.props

const rssUrl = new URL('/rss.xml', Astro.site).toString()
const panelId = `rss-panel-${Math.random().toString(36).slice(2, 9)}`

const readers = [
  {
    label: 'Add to Feedly',
    href: `https://feedly.com/i/subscription/feed/${encodeURIComponent(rssUrl)}`,
    event: 'rss-subscribe-feedly',
  },
  {
    label: 'Add to Inoreader',
    // `?add_feed=` subscribes directly; the `/feed/` preview route dead-ends on a login wall.
    href: `https://www.inoreader.com/?add_feed=${encodeURIComponent(rssUrl)}`,
    event: 'rss-subscribe-inoreader',
  },
]
---

<div class:list={['rss-dropdown relative inline-block', className]} data-placement={placement} data-align={align}>
  <button
    type="button"
    class="rss-dropdown-trigger flex items-center gap-2 text-neutral-600 transition-colors hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
    aria-expanded="false"
    aria-controls={panelId}
    data-umami-event="rss-dropdown-toggle"
  >
    <Icon name="lucide:rss" class="size-4 shrink-0" />
    <span>Subscribe via RSS</span>
    <Icon name="lucide:chevron-down" class="rss-dropdown-chevron size-4 shrink-0" />
  </button>

  <div
    id={panelId}
    class="rss-dropdown-panel absolute z-50 w-max max-w-[calc(100vw-2rem)] min-w-56 rounded-md border border-[var(--border-color-subtle)] bg-[var(--background-color)] shadow-lg"
    hidden
  >
    <div class="flex flex-col divide-y divide-[var(--border-color-subtle)]">
      {
        readers.map(({ label, href, event }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 px-4 py-3 transition-colors"
            data-umami-event={event}
          >
            <Icon name="lucide:external-link" class="size-4 shrink-0 text-neutral-500" />
            {label}
          </a>
        ))
      }
      <button
        type="button"
        class="rss-dropdown-copy flex w-full items-center gap-3 px-4 py-3 text-start transition-colors"
        data-rss-url={rssUrl}
        data-umami-event="rss-copy-link"
      >
        <Icon name="lucide:copy" class="rss-dropdown-copy-idle size-4 shrink-0 text-neutral-500" />
        <Icon name="lucide:check" class="rss-dropdown-copy-done size-4 shrink-0 text-green-500" />
        <span class="rss-dropdown-copy-label">Copy Link</span>
      </button>
      <a href="/rss.xml" class="flex items-center gap-3 px-4 py-3 transition-colors" data-umami-event="rss-view-xml">
        <Icon name="lucide:file-code" class="size-4 shrink-0 text-neutral-500" />
        View RSS XML
      </a>
    </div>
  </div>

  <span class="rss-dropdown-status sr-only" role="status"></span>
</div>

<script>
  const DROPDOWN = '.rss-dropdown'
  const TRIGGER = '.rss-dropdown-trigger'
  const PANEL = '.rss-dropdown-panel'
  const COPY_RESET_DELAY = 2000

  const setExpanded = (dropdown: Element, expanded: boolean) => {
    const trigger = dropdown.querySelector(TRIGGER)
    const panel = dropdown.querySelector<HTMLElement>(PANEL)
    if (!trigger || !panel) return

    trigger.setAttribute('aria-expanded', String(expanded))
    panel.hidden = !expanded
  }

  const closeAll = (except?: Element | null) => {
    document.querySelectorAll(DROPDOWN).forEach((dropdown) => {
      if (dropdown !== except) setExpanded(dropdown, false)
    })
  }

  const copyTimeouts = new WeakMap<HTMLElement, number>()

  const copyFeedUrl = async (button: HTMLElement) => {
    const url = button.dataset.rssUrl
    const label = button.querySelector('.rss-dropdown-copy-label')
    const status = button.closest(DROPDOWN)?.querySelector('.rss-dropdown-status')
    if (!url || !label) return

    let message: string
    try {
      await navigator.clipboard.writeText(url)
      button.dataset.copyState = 'done'
      message = 'Copied!'
    } catch {
      button.dataset.copyState = 'failed'
      message = 'Copy failed'
    }

    label.textContent = message
    if (status) status.textContent = `${message} ${url}`

    clearTimeout(copyTimeouts.get(button))
    copyTimeouts.set(
      button,
      window.setTimeout(() => {
        delete button.dataset.copyState
        label.textContent = 'Copy Link'
        if (status) status.textContent = ''
      }, COPY_RESET_DELAY),
    )
  }

  const onDocumentClick = (event: MouseEvent) => {
    const target = event.target as Element | null
    const dropdown = target?.closest(DROPDOWN)

    if (!dropdown) {
      closeAll()
      return
    }

    const trigger = target?.closest(TRIGGER)
    if (trigger) {
      const wasExpanded = trigger.getAttribute('aria-expanded') === 'true'
      closeAll(dropdown)
      setExpanded(dropdown, !wasExpanded)
      return
    }

    const copyButton = target?.closest<HTMLElement>('.rss-dropdown-copy')
    if (copyButton) {
      copyFeedUrl(copyButton)
      return
    }

    if (target?.closest('a')) closeAll()
  }

  const onDocumentKeydown = (event: KeyboardEvent) => {
    if (event.key !== 'Escape') return

    const openTrigger = document.querySelector<HTMLElement>(`${TRIGGER}[aria-expanded='true']`)
    if (!openTrigger) return

    closeAll()
    openTrigger.focus()
  }

  const onDocumentFocusin = (event: FocusEvent) => {
    closeAll((event.target as Element | null)?.closest(DROPDOWN))
  }

  // Astro re-runs this module on every HMR update. Binding twice would make each click
  // toggle the panel open and straight back closed.
  const scope = window as typeof window & { rssDropdownBound?: boolean }

  if (!scope.rssDropdownBound) {
    scope.rssDropdownBound = true
    document.addEventListener('click', onDocumentClick)
    document.addEventListener('keydown', onDocumentKeydown)
    document.addEventListener('focusin', onDocumentFocusin)
  }
</script>

<style lang="scss">
  .rss-dropdown {
    font-size: var(--font-size--1);
    line-height: 1.4;
  }

  .rss-dropdown-panel {
    transform-origin: var(--rss-dropdown-origin-block, top) var(--rss-dropdown-origin-inline, left);
    animation: rss-dropdown-in var(--animation-speed-fast, 0.1s) var(--cubic-bezier, ease-out);
    margin-block-start: 0.5rem;
    inset-block-start: 100%;
    inset-inline-start: 0;

    a {
      color: var(--foreground-color);
      text-decoration: none;

      &:where(:hover, :focus-visible) {
        color: var(--foreground-color);
      }
    }

    :where(a, .rss-dropdown-copy):where(:hover, :focus-visible) {
      background-color: var(--border-color-subtle);
    }
  }

  .rss-dropdown[data-placement='top'] .rss-dropdown-panel {
    --rss-dropdown-origin-block: bottom;

    margin-block: 0 0.5rem;
    inset-block: auto 100%;
  }

  .rss-dropdown[data-align='end'] .rss-dropdown-panel {
    --rss-dropdown-origin-inline: right;

    inset-inline: auto 0;
  }

  .rss-dropdown-chevron {
    transition: rotate var(--animation-speed-fast, 0.2s) var(--cubic-bezier, ease-out);
  }

  .rss-dropdown-trigger[aria-expanded='true'] .rss-dropdown-chevron {
    rotate: 180deg;
  }

  .rss-dropdown-copy-done,
  .rss-dropdown-copy[data-copy-state] .rss-dropdown-copy-idle {
    display: none;
  }

  .rss-dropdown-copy[data-copy-state='done'] .rss-dropdown-copy-done {
    display: block;
  }

  .rss-dropdown-copy[data-copy-state='failed'] .rss-dropdown-copy-idle {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .rss-dropdown-panel {
      animation: none;
    }

    .rss-dropdown-chevron {
      transition: none;
    }
  }

  @keyframes rss-dropdown-in {
    from {
      transform: scale(0.95);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>
