---
import { Icon } from 'astro-icon/components'

interface Props {
  class?: string
}

const { class: className } = Astro.props
const rssUrl = new URL('/rss.xml', Astro.site).toString()
---

<div class:list={['rss-dropdown-container relative inline-block text-left', className]}>
  <button
    type="button"
    class="rss-dropdown-trigger flex items-center gap-2 text-sm text-neutral-600 transition-colors hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100"
    aria-expanded="false"
    aria-haspopup="true"
    data-umami-event="rss-dropdown-open"
  >
    <Icon name="lucide:rss" class="h-4 w-4 md:h-5 md:w-5" />
    <span>Subscribe via RSS</span>
    <Icon name="lucide:chevron-down" class="h-4 w-4 transition-transform duration-200" />
  </button>

  <div
    class="rss-dropdown-menu absolute right-0 z-50 mt-2 hidden w-56 origin-top-right rounded-md border border-[var(--border-color-subtle)] bg-[var(--background-color)] shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none"
    role="menu"
    aria-orientation="vertical"
    tabindex="-1"
  >
    <div class="flex flex-col divide-y divide-[var(--border-color-subtle)]" role="none">
      <a
        href={`https://feedly.com/i/subscription/feed/${encodeURIComponent(rssUrl)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="!no-underline !text-neutral-900 dark:!text-neutral-100 flex items-center gap-3 px-4 py-3 text-sm hover:bg-[var(--border-color-subtle)] transition-colors"
        role="menuitem"
        data-umami-event="rss-subscribe-feedly"
      >
        <Icon name="lucide:external-link" class="h-4 w-4 text-neutral-500 shrink-0" />
        Add to Feedly
      </a>
      <a
        href={`https://www.inoreader.com/feed/${encodeURIComponent(rssUrl)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="!no-underline !text-neutral-900 dark:!text-neutral-100 flex items-center gap-3 px-4 py-3 text-sm hover:bg-[var(--border-color-subtle)] transition-colors"
        role="menuitem"
        data-umami-event="rss-subscribe-inoreader"
      >
        <Icon name="lucide:external-link" class="h-4 w-4 text-neutral-500 shrink-0" />
        Add to Inoreader
      </a>
      <a
        href={`https://readwise.io/read/add?url=${encodeURIComponent(rssUrl)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="!no-underline !text-neutral-900 dark:!text-neutral-100 flex items-center gap-3 px-4 py-3 text-sm hover:bg-[var(--border-color-subtle)] transition-colors"
        role="menuitem"
        data-umami-event="rss-subscribe-readwise"
      >
        <Icon name="lucide:external-link" class="h-4 w-4 text-neutral-500 shrink-0" />
        Add to Reader (Readwise)
      </a>
      <button
        type="button"
        class="!no-underline !text-neutral-900 dark:!text-neutral-100 rss-copy-btn flex w-full items-center gap-3 px-4 py-3 text-left text-sm hover:bg-[var(--border-color-subtle)] transition-colors"
        role="menuitem"
        data-rss-url={rssUrl}
        data-umami-event="rss-copy-link"
      >
        <Icon name="lucide:copy" class="h-4 w-4 text-neutral-500 rss-copy-icon shrink-0" />
        <Icon name="lucide:check" class="h-4 w-4 text-green-500 rss-check-icon hidden shrink-0" />
        <span class="rss-copy-text">Copy Link</span>
      </button>
      <a
        href="/rss.xml"
        class="!no-underline !text-neutral-900 dark:!text-neutral-100 flex items-center gap-3 px-4 py-3 text-sm hover:bg-[var(--border-color-subtle)] transition-colors"
        role="menuitem"
        data-umami-event="rss-view-xml"
      >
        <Icon name="lucide:file-code" class="h-4 w-4 text-neutral-500 shrink-0" />
        View RSS XML
      </a>
    </div>
  </div>
</div>

<script>
  function setupRssDropdowns() {
    const containers = document.querySelectorAll('.rss-dropdown-container')

    containers.forEach((container) => {
      const trigger = container.querySelector('.rss-dropdown-trigger') as HTMLButtonElement
      const menu = container.querySelector('.rss-dropdown-menu') as HTMLDivElement
      const chevron = trigger.querySelector('.lucide-chevron-down') as HTMLElement
      const copyBtn = container.querySelector('.rss-copy-btn') as HTMLButtonElement
      const copyIcon = copyBtn?.querySelector('.rss-copy-icon') as HTMLElement
      const checkIcon = copyBtn?.querySelector('.rss-check-icon') as HTMLElement
      const copyText = copyBtn?.querySelector('.rss-copy-text') as HTMLElement

      // Toggle menu
      trigger.addEventListener('click', (e) => {
        e.stopPropagation()
        const isExpanded = trigger.getAttribute('aria-expanded') === 'true'

        // Close all other dropdowns first
        document.querySelectorAll('.rss-dropdown-trigger').forEach(t => {
          t.setAttribute('aria-expanded', 'false')
          const c = t.closest('.rss-dropdown-container')
          c?.querySelector('.rss-dropdown-menu')?.classList.add('hidden')
          const chev = t.querySelector('.lucide-chevron-down') as HTMLElement
          if(chev) chev.style.transform = 'rotate(0deg)'
        })

        if (!isExpanded) {
          trigger.setAttribute('aria-expanded', 'true')
          menu.classList.remove('hidden')
          if(chevron) chevron.style.transform = 'rotate(180deg)'
        }
      })

      // Handle click outside to close
      document.addEventListener('click', (event) => {
        if (!container.contains(event.target as Node)) {
          trigger.setAttribute('aria-expanded', 'false')
          menu.classList.add('hidden')
          if(chevron) chevron.style.transform = 'rotate(0deg)'
        }
      })

      // Handle copy link
      if (copyBtn) {
        copyBtn.addEventListener('click', async (e) => {
          e.stopPropagation()
          const url = copyBtn.getAttribute('data-rss-url')
          if (url) {
            try {
              await navigator.clipboard.writeText(url)

              // Show success state
              copyIcon.classList.add('hidden')
              checkIcon.classList.remove('hidden')
              copyText.textContent = 'Copied!'

              // Reset after 2 seconds
              setTimeout(() => {
                copyIcon.classList.remove('hidden')
                checkIcon.classList.add('hidden')
                copyText.textContent = 'Copy Link'
              }, 2000)
            } catch (err) {
              console.error('Failed to copy: ', err)
            }
          }
        })
      }
    })
  }

  // Setup on initial load
  setupRssDropdowns()

  // Re-run setup on View Transitions (Astro)
  document.addEventListener('astro:page-load', setupRssDropdowns)
</script>

<style>
  .rss-dropdown-menu {
    transform-origin: top right;
    animation: dropdown-fade-in 0.1s ease-out;
  }

  @keyframes dropdown-fade-in {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
